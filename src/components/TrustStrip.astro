---
import type { Lang } from '@/data/site';
import { t } from '@/i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t(lang);
// Text, not badges-as-images (§5) — these must be selectable and indexable.
const items = [
  s.home.trustStrip.apic,
  s.home.trustStrip.abrates,
  s.home.trustStrip.cnpj,
  s.home.trustStrip.nf,
  s.home.trustStrip.area,
];
---
<section class="trust" aria-label={s.home.trustStrip.label}>
  <div class="shell">
    <ul>
      {items.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<style>
  .trust {
    background: var(--brand);
    color: var(--page);
    padding-block: var(--space-m);
    border-block-end: 3px solid var(--channel);
  }
  ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem var(--space-m);
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 500;
  }
  li { display: flex; align-items: center; gap: var(--space-m); }
  li + li::before {
    content: '';
    width: 4px; height: 4px;
    border-radius: 50%;
    background: var(--channel);
    margin-inline-start: calc(var(--space-m) * -0.5);
  }
</style>
