---
import type { Lang } from '@/data/site';

interface Props {
  lang: Lang;
  /** Unlisted YouTube id. Nothing loads from YouTube until the click (§10). */
  youtubeId: string;
  poster: string;
  label: string;
}
const { youtubeId, poster, label } = Astro.props;
---
<div class="facade" data-yt={youtubeId}>
  <button type="button" data-play>
    <img src={poster} alt="" width="1280" height="720" loading="lazy" decoding="async" />
    <span class="play" aria-hidden="true">▶</span>
    <span class="label">{label}</span>
  </button>
</div>

<style>
  .facade { position: relative; background: var(--brand-deep); }
  button {
    display: block; width: 100%; padding: 0; border: 0; cursor: pointer;
    background: none; position: relative; color: var(--page);
  }
  img { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; opacity: 0.75; }
  .play {
    position: absolute; inset-block-start: 50%; inset-inline-start: 50%;
    transform: translate(-50%, -50%);
    font-size: 2.5rem; line-height: 1;
    background: var(--channel); color: var(--ink);
    width: 4rem; height: 4rem; border-radius: 50%;
    display: grid; place-items: center;
  }
  .label {
    position: absolute; inset-block-end: 0; inset-inline: 0;
    padding: var(--space-s) var(--space-m);
    font-family: var(--font-display); font-size: var(--step--1); font-weight: 600;
    text-align: start;
    background: linear-gradient(transparent, rgb(12 39 36 / 0.85));
  }
  iframe { width: 100%; aspect-ratio: 16 / 9; border: 0; display: block; }
</style>

<script>
  // Island 3 of 3: click-to-load video facade (§12).
  document.querySelectorAll<HTMLElement>('.facade').forEach((facade) => {
    facade.querySelector('[data-play]')?.addEventListener('click', () => {
      const id = facade.dataset.yt;
      if (!id) return;
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      frame.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture';
      frame.allowFullscreen = true;
      frame.title = facade.querySelector('.label')?.textContent ?? 'Video';
      facade.replaceChildren(frame);
    });
  });
</script>
